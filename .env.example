# Copy to apps/web/.env.local. Generate a fresh local token for both processes.
APP_ORIGIN=http://127.0.0.1:3000
FORECAST_SERVICE_URL=http://127.0.0.1:8001
FORECAST_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Optional absolute directory; default is apps/web/.data/forewise
# DATABASE_PATH=C:/path/to/forewise-local-db
